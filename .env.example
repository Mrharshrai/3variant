# ── Contact form delivery ──────────────────────────────────
# 1) Set VITE_CONTACT_ENDPOINT to POST the form as JSON.
#    Works with Formspree (https://formspree.io), Zapier webhooks,
#    or any custom API. Leave unset to use the mailto fallback.
VITE_CONTACT_ENDPOINT=

# 2) Address used by the mailto: fallback when no endpoint is configured.
VITE_CONTACT_EMAIL=hello@3variant.com